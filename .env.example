# Copia este archivo como .env.local para trabajar en local. En Vercel, añade las mismas
# variables en Settings → Environment Variables. Nunca subas los valores reales al repositorio.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Cadena aleatoria de al menos 32 caracteres (firma la sesión). Por ejemplo: openssl rand -hex 32
SESSION_SECRET=

# Gmail: correo y contraseña de aplicación (Cuenta de Google → Seguridad → Contraseñas de aplicaciones).
# Sin ellas, en local los correos se muestran en la consola y el código aparece en pantalla.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cadena aleatoria para proteger /api/cron. Vercel la usa sola en su tarea diaria (vercel.json → «crons»).
# (Opcional: si además se quiere la tarea de cada hora de GitHub, el secreto CRON_SECRET de GitHub debe ser el mismo.)
CRON_SECRET=

# URL pública para los enlaces de los correos (en Vercel se detecta sola si no se pone)
SITIO_URL=

# Correos que pueden entrar y reservar antes del 30 de octubre, separados por comas
# (luciasedeno, nataliapeinado y mariaortiz @alumnado.esada.es ya están incluidos en lib/config.js)
CORREOS_PRUEBA=

# Solo para pruebas: "true" permite reservar a CUALQUIERA antes del 30 de octubre. Quítalo antes de abrir.
PERMITIR_ANTES_DE_APERTURA=

# Contraseña de la entrada de administración (botón «Admin» de la cuenta atrás, correo lilium@esada.es).
# Mínimo 12 caracteres. Solo en Vercel, nunca en el código.
ADMIN_CLAVE=
